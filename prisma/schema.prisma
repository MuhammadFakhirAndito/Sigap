datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StatusTsunami {
  AMAN
  BERPOTENSI
  TIDAK_DINYATAKAN
}

enum KategoriArtikel {
  PENGERTIAN
  PROSES
  PENANGGULANGAN
  MITIGASI
  LAINNYA
}

enum TipeLokasi {
  DARAT
  LAUT
}

enum ChatSource {
  LLM
  FALLBACK
}

model Gempa {
  id            String        @id @default(cuid())
  bmkgKey       String        @unique
  waktuUtc      DateTime
  lat           Float
  lon           Float
  magnitudo     Float
  kedalamanKm   Float
  wilayah       String
  potensiTeks   String
  statusTsunami StatusTsunami @default(TIDAK_DINYATAKAN)
  dirasakan     String?
  shakemapUrl   String?
  isAuto        Boolean       @default(false)
  isTerkini     Boolean       @default(false)
  isDirasakan   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([waktuUtc(sort: Desc)])
  @@index([magnitudo])
  @@map("gempa")
}

model SyncLog {
  id               String   @id @default(cuid())
  sumber           String
  status           String
  jumlahBaru       Int      @default(0)
  jumlahDiperbarui Int      @default(0)
  pesanError       String?
  durasiMs         Int
  createdAt        DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("sync_log")
}

model Berita {
  id            String   @id @default(cuid())
  judul         String
  sumber        String
  url           String   @unique
  tanggalTerbit DateTime
  ringkasan     String?
  createdAt     DateTime @default(now())

  @@map("berita")
}

model Artikel {
  id        String          @id @default(cuid())
  slug      String          @unique
  judul     String
  kategori  KategoriArtikel
  isi       String          @db.Text
  urutan    Int             @default(0)
  updatedAt DateTime        @updatedAt
  sumber    Sumber[]        @relation("ArtikelSumber")

  @@map("artikel")
}

model Sumber {
  id               String             @id @default(cuid())
  judul            String
  penerbit         String
  url              String             @unique
  tanggalAkses     DateTime
  artikel          Artikel[]          @relation("ArtikelSumber")
  skenarioSimulasi SkenarioSimulasi[]

  @@map("sumber")
}

model FaqGempa {
  id         String   @id @default(cuid())
  kataKunci  String[]
  pertanyaan String
  jawaban    String   @db.Text
  aktif      Boolean  @default(true)

  @@map("faq_gempa")
}

model ChatLog {
  id             String     @id @default(cuid())
  pertanyaan     String     @db.Text
  jawaban        String     @db.Text
  source         ChatSource
  model          String?
  responseTimeMs Int?
  isHelpful      Boolean?
  ipHash         String?
  createdAt      DateTime   @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("chat_log")
}

model KuotaHarian {
  id      String   @id @default(cuid())
  model   String
  tanggal DateTime @db.Date
  jumlah  Int      @default(0)

  @@unique([model, tanggal])
  @@map("kuota_harian")
}

model SkenarioSimulasi {
  id               String     @id @default(cuid())
  nama             String
  magnitudo        Float
  kedalamanKm      Float
  lat              Float
  lon              Float
  tipeLokasi       TipeLokasi
  deskripsiSingkat String?
  urutan           Int        @default(0)
  sumberId         String?
  sumber           Sumber?    @relation(fields: [sumberId], references: [id])

  @@map("skenario_simulasi")
}
