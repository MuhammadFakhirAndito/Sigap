# ==========================================
# Konfigurasi Database PostgreSQL (Docker / VPS)
# ==========================================
POSTGRES_USER="sigap_user"
POSTGRES_PASSWORD="sigap_password_secure"
POSTGRES_DB="sigap_gempa"
DATABASE_URL="postgresql://sigap_user:sigap_password_secure@localhost:5432/sigap_gempa?schema=public"

# ==========================================
# Konfigurasi Redis Cache & Rate Limit (Opsional)
# ==========================================
REDIS_PASSWORD="sigap_redis_password"
REDIS_URL="redis://:sigap_redis_password@localhost:6379"

# ==========================================
# Google Gemini API (Chatbot SIGAP)
# ==========================================
# Model Utama (gemini-1.5-flash)
GEMINI_API_KEY=""
# Model Cadangan (gemini-1.5-flash-8b - Fallback jika kuota habis / error 429)
GEMINI_BACKUP_API_KEY=""

# ==========================================
# Keamanan & Rahasia Sistem (PRD v0.2 Bagian 8.5)
# ==========================================
# Token rahasia otentikasi cron & endpoint sinkronisasi BMKG (/api/sync)
SYNC_SECRET="sigap_sync_secret_key_change_me"

# Kunci rahasia HMAC untuk hashing alamat IP pengguna di ChatLog
LOG_HMAC_SECRET="sigap_secure_hmac_secret_key_change_me"

# ==========================================
# Aplikasi Web
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
