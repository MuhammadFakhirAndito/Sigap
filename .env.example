# ==============================================================================
# Contoh Konfigurasi Environment SIGAP Gempa
# Salin ke .env lalu isi nilai acak sebelum menjalankan container.
# JANGAN meng-commit .env ke Git.
#
# Cara membuat nilai acak aman (hex tidak mengandung karakter khusus URL):
#   openssl rand -hex 32
# Jika password mengandung karakter khusus (+, /, =, @, :, #), wajib URL-encode
# sebelum dimasukkan ke DATABASE_URL.
#
# CATATAN KEAMANAN: Password contoh lama pernah ada di riwayat Git awal dan
# DILARANG keras digunakan di lingkungan produksi.
# ==============================================================================

# Peran admin bootstrap PostgreSQL (hanya untuk inisialisasi awal container)
POSTGRES_ADMIN_USER="pgadmin"
POSTGRES_ADMIN_PASSWORD="<ganti-dengan-output-openssl-rand-hex-32>"

# Peran aplikasi non-superuser (NOSUPERUSER NOCREATEDB NOCREATEROLE)
POSTGRES_APP_PASSWORD="<ganti-dengan-output-openssl-rand-hex-32>"

# Peran dev opsional (hanya diisi di lokal agar bisa menjalankan `prisma migrate dev`
# yang membutuhkan hak CREATEDB untuk shadow database; JANGAN isi di produksi)
POSTGRES_DEV_PASSWORD=""

# Koneksi utama aplikasi & `prisma migrate deploy` (memakai peran `sigap`)
# Untuk development lokal pada host mesin pengembang:
DATABASE_URL="postgresql://sigap:<POSTGRES_APP_PASSWORD_URL_ENCODED>@127.0.0.1:5432/sigap?schema=public"

# Untuk menjalankan `prisma migrate dev` di lokal saja (opsional, pakai `sigap_dev`):
# DATABASE_URL="postgresql://sigap_dev:<POSTGRES_DEV_PASSWORD_URL_ENCODED>@127.0.0.1:5432/sigap?schema=public"

# Rahasia sinkronisasi BMKG & pembersihan ChatLog (Wajib acak minimal 32 byte di produksi)
SYNC_SECRET="<ganti-dengan-output-openssl-rand-hex-32>"

# Kunci HMAC untuk hashing IP ChatLog (Wajib acak minimal 32 byte di produksi)
LOG_HMAC_SECRET="<ganti-dengan-output-openssl-rand-hex-32>"

# URL dasar aplikasi (atau domain HTTPS di produksi)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Konfigurasi Tile Peta Simulasi (OpenStreetMap standar; dapat diganti tanpa ubah kode)
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>'

# Konfigurasi Chatbot Gemini (Fase 3)
GEMINI_API_KEY="<ganti-dengan-gemini-api-key-anda>"
GEMINI_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_PRIMARY_THINKING_LEVEL="MINIMAL"
GEMINI_PRIMARY_MAX_OUTPUT_TOKENS="1024"
GEMINI_PRIMARY_SUPPORTS_TEMPERATURE="true"
GEMINI_PRIMARY_DAILY_QUOTA="20"
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_THINKING_LEVEL="LOW"
GEMINI_FALLBACK_MAX_OUTPUT_TOKENS="2048"
GEMINI_FALLBACK_SUPPORTS_TEMPERATURE="false"
GEMINI_FALLBACK_DAILY_QUOTA="20"
GEMINI_QUOTA_RESET_TIMEZONE="America/Los_Angeles"
GEMINI_TEMPERATURE="0.2"
TRUST_PROXY="false"
