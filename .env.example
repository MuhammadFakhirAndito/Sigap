# ==========================================
# Konfigurasi Database PostgreSQL (Docker / VPS)
# ==========================================
POSTGRES_USER="sigap_user"
POSTGRES_PASSWORD="sigap_password_secure"
POSTGRES_DB="sigap_gempa"
DATABASE_URL="postgresql://sigap_user:sigap_password_secure@localhost:5432/sigap_gempa?schema=public"

# ==========================================
# Konfigurasi Redis Cache & Rate Limit
# ==========================================
REDIS_PASSWORD="sigap_redis_password"
REDIS_URL="redis://:sigap_redis_password@localhost:6379"

# ==========================================
# Google Gemini API (Chatbot SIGAP Gempa)
# ==========================================
# Model Utama (misal: gemini-2.0-flash / gemini-1.5-flash)
GEMINI_API_KEY=""
# Model Cadangan (Fallback jika kuota model utama habis / error 429)
GEMINI_BACKUP_API_KEY=""

# ==========================================
# Keamanan & Endpoint Sinkronisasi BMKG
# ==========================================
BMKG_SYNC_SECRET="sigap_sync_secret_key_change_me"

# ==========================================
# Aplikasi Web
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
