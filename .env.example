# PostgreSQL connection string
# Untuk development lokal pada host mesin pengembang:
DATABASE_URL="postgresql://sigap:sigap_password@127.0.0.1:5432/sigap?schema=public"

# Untuk container aplikasi dalam jaringan Docker Compose:
# DATABASE_URL="postgresql://sigap:sigap_password@postgres:5432/sigap?schema=public"

# Rahasia sinkronisasi BMKG (Wajib diganti di produksi)
SYNC_SECRET="ganti-dengan-rahasia-acak-panjang-di-produksi"

# Kunci HMAC untuk hashing IP ChatLog (Wajib diganti di produksi)
LOG_HMAC_SECRET="ganti-dengan-rahasia-hmac-panjang-di-produksi"

# URL dasar aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
