# PostgreSQL connection string
# Untuk development lokal pada host mesin pengembang:
DATABASE_URL="postgresql://sigap:sigap_password@127.0.0.1:5432/sigap?schema=public"

# Untuk container aplikasi dalam jaringan Docker Compose:
# DATABASE_URL="postgresql://sigap:sigap_password@postgres:5432/sigap?schema=public"

# Rahasia sinkronisasi BMKG (Wajib diganti di produksi)
SYNC_SECRET="ganti-dengan-rahasia-acak-panjang-di-produksi"

# Kunci HMAC untuk hashing IP ChatLog (Wajib diganti di produksi)
LOG_HMAC_SECRET="ganti-dengan-rahasia-hmac-panjang-di-produksi"

# URL dasar aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Konfigurasi Tile Peta Simulasi (OpenStreetMap standar; dapat diganti tanpa ubah kode)
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>'

# Konfigurasi Chatbot Gemini (Fase 3)
GEMINI_API_KEY="ganti-dengan-gemini-api-key-anda"
GEMINI_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_PRIMARY_THINKING_LEVEL="MINIMAL"
GEMINI_PRIMARY_MAX_OUTPUT_TOKENS="1024"
GEMINI_PRIMARY_SUPPORTS_TEMPERATURE="true"
GEMINI_PRIMARY_DAILY_QUOTA="20"
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_THINKING_LEVEL="LOW"
GEMINI_FALLBACK_MAX_OUTPUT_TOKENS="2048"
GEMINI_FALLBACK_SUPPORTS_TEMPERATURE="false"
GEMINI_FALLBACK_DAILY_QUOTA="20"
GEMINI_QUOTA_RESET_TIMEZONE="America/Los_Angeles"
GEMINI_TEMPERATURE="0.2"
TRUST_PROXY="false"
