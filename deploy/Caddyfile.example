# Contoh Caddyfile Opsional untuk SIGAP Gempa
# Pakai hanya bila menjalankan reverse proxy HTTPS di depan container `app`.
# Ganti `sigap.contoh.id` dengan domain Anda sendiri.

sigap.contoh.id {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy 127.0.0.1:3000
}
